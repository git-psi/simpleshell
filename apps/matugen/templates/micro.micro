# Generated by simpleshell (apps/matugen): rewritten on every theme change.
color-link default "{{hs.text}},{{hs.bg}}"
color-link comment "italic {{hs.dim}}"
color-link identifier "{{colors.blue.default.hex}}"
color-link constant "{{colors.magenta.default.hex}}"
color-link constant.string "{{colors.green.default.hex}}"
color-link symbol "{{hs.text}}"
color-link type "{{colors.cyan.default.hex}}"
color-link statement "{{hs.accent}}"
color-link special "{{colors.primary.default.hex}}"
color-link preproc "{{colors.primary.default.hex}}"
color-link underlined "{{colors.cyan.default.hex}}"
color-link error "bold {{colors.red.default.hex}}"
color-link todo "bold {{hs.accent}}"
color-link diff-added "{{colors.green.default.hex}}"
color-link diff-modified "{{hs.accent}}"
color-link diff-deleted "{{colors.red.default.hex}}"
color-link gutter-error "{{colors.red.default.hex}}"
color-link gutter-warning "{{hs.accent}}"
color-link statusline "{{hs.text}},{{hs.sunken}}"
color-link tabbar "{{hs.text}},{{hs.sunken}}"
color-link indent-char "{{hs.hi}}"
color-link line-number "{{hs.dim}},{{hs.bg}}"
color-link current-line-number "{{hs.accent}},{{hs.bg}}"
color-link cursor-line "{{hs.sunken}}"
color-link color-column "{{hs.sunken}}"
color-link selection "{{hs.ink}},{{hs.accent}}"
color-link message "{{hs.text}},{{hs.bg}}"
color-link error-message "bold {{colors.red.default.hex}},{{hs.bg}}"
color-link scrollbar "{{hs.hi}}"
